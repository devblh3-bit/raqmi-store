TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# provider keys (put real values in .env only)
QCST_API_KEY=
VBR_API_KEY=
CANBOSO_API_KEY=

DATABASE_URL=
ENCRYPTION_KEY=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=

# auth
SESSION_SECRET=            # openssl rand -base64 48
TELEGRAM_BOT_USERNAME=     # public @username of the bot (no @); enables the login widget
RESEND_API_KEY=            # optional; unset = magic links logged to server console (dev)
EMAIL_FROM=
CRON_SECRET=              # guards /api/cron/*; openssl rand -base64url 32

# blockchain / crypto payments
BSC_RPC_URL=              # NodeReal BSC Mainnet RPC endpoint (e.g. https://bsc-mainnet.nodereal.io/v1/...)
